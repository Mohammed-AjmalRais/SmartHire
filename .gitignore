pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Databases & Runtime Data
backend/data/
data/
*.mv.db
*.trace.db

# File Uploads
backend/uploads/
uploads/

# Node & Frontend Build
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and Editor Files
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.classpath
.project
.settings/
*.sublime-workspace
*.sublime-project

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables
.env
.env.*
!.env.example
